Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"H", "[", 
     RowBox[{"k_", ",", "v_"}], "]"}], ":=", 
    TagBox[
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {
         RowBox[{"2", "t", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"k", " ", "a"}], "]"}]}], "v"},
        {"v", 
         RowBox[{
          RowBox[{"-", "2"}], "t", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"k", " ", "a"}], "]"}]}]}
       },
       GridBoxAlignment->{
